# Fichier exemple des secrets
# Copier son contenu dans un fichier "env.properties" à la racine du projet et le remplir avec vos valeurs

# Configuration niveau de logging
APP_LOGGING_LEVEL=INFO

# Configuration des ports des apps
API_GATEWAY_PORT=8080
FRONTEND_SERVICE_PORT=8081
PATIENT_SERVICE_PORT=8082
NOTE_PRATICIEN_SERVICE_PORT=8083
EVALUATION_RISQUE_SERVICE_PORT=8084

# Configuration des url des apps
FRONTEND_SERVICE_URL=http://localhost:8081
PATIENT_SERVICE_URL=http://localhost:8082
NOTE_PRATICIEN_SERVICE_URL=http://localhost:8083
EVALUATION_RISQUE_SERVICE_URL=http://localhost:8084

# Adresse publique de la Gateway (vue depuis le navigateur).
# Sert a alimenter les X-Forwarded-Host/Proto envoyes au frontend pour qu'il construise
# ses URLs absolues correctement et n'expose pas l'hote Docker interne.
# Defauts : localhost:${API_GATEWAY_PORT} et http -- ne pas definir en dev local.
#GATEWAY_PUBLIC_HOST=medilabo.example.com
#GATEWAY_PUBLIC_PROTO=https

# Configuration of basic user credentials
MEDILABO_USERNAME=user
MEDILABO_PASSWORD=password

# Configuration of the MySQL database for patient_service
MYSQL_ROOT_PASSWORD=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=patient-service
MYSQL_USER=patient-service
MYSQL_PASSWORD=mysql

# Configuration of the MongoDB database for note_praticien_service
MONGO_INITDB_DATABASE=note-praticien-service
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongodb
MONGODB_HOST=localhost
MONGODB_PORT=27018
MONGODB_DATABASE=note-praticien-service
MONGODB_USER=note_praticien_service
MONGODB_PASSWORD=mongodb
MONGODB_AUTH_DATABASE=note-praticien-service

DDL_AUTO=validate
